{
  "name": "vscode-designer-14",
  "private": true,
  "preview": true,
  "version": "14.0.1",
  "description": "%extension.description%",
  "publisher": "axonivy",
  "author": "Axon Ivy AG",
  "type": "module",
  "homepage": "https://developer.axonivy.com/",
  "repository": {
    "url": "https://github.com/axonivy/vscode-designer"
  },
  "icon": "assets/ivy-logo.png",
  "displayName": "%extension.displayName%",
  "engines": {
    "vscode": "^1.136.1"
  },
  "scripts": {
    "build": "node esbuild.mts",
    "build:production": "pnpm run generate:schemas && node esbuild.mts --production",
    "clean": "rimraf lib dist *.tsbuildinfo",
    "generate:schemas": "node ./scripts/generate-ivy-schemas.mts",
    "generate:market": "node ./scripts/marketSchemaCodegen.cjs",
    "generate:runtimelog": "node ./scripts/runtimelogSchemaCodegen.cjs",
    "package": "node ../scripts/set-milestone.mts && bash -c 'vsce package --no-update-package-json --no-git-tag-version --no-dependencies ${npm_package_version/./}.${MILESTONE:-$(date \"+%Y%m%d%H\")}'",
    "publish:next": "node ../scripts/set-milestone.mts && bash -c 'vsce publish --no-update-package-json --no-git-tag-version --no-dependencies ${npm_package_version/./}.${MILESTONE:-$(date \"+%Y%m%d%H\")}'",
    "test": "vitest",
    "test:ci": "vitest run",
    "i18n": "vscode-l10n-dev export -o ./l10n ./src",
    "i18n:ci": "pnpm run i18n && node ./scripts/check-i18n-catalogs.mjs",
    "type": "tsc --noEmit",
    "watch": "node esbuild.mts --watch"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "dependencies": {
    "@axonivy/case-map-editor-protocol": "next-14.0.1",
    "@axonivy/cms-editor-protocol": "next-14.0.1",
    "@axonivy/database-editor-protocol": "next-14.0.1",
    "@axonivy/dataclass-editor-protocol": "next-14.0.1",
    "@axonivy/form-editor-protocol": "next-14.0.1",
    "@axonivy/jsonrpc": "next-14.0.1",
    "@axonivy/persistence-editor-protocol": "next-14.0.1",
    "@axonivy/process-editor-inscription-protocol": "next-14.0.1",
    "@axonivy/process-editor-protocol": "next-14.0.1",
    "@axonivy/restclient-editor-protocol": "next-14.0.1",
    "@axonivy/role-editor-protocol": "next-14.0.1",
    "@axonivy/user-editor-protocol": "next-14.0.1",
    "@axonivy/variable-editor-protocol": "next-14.0.1",
    "@axonivy/webservice-editor-protocol": "next-14.0.1",
    "@eclipse-glsp/protocol": "2.7.0",
    "@eclipse-glsp/vscode-integration": "2.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "1.20.0",
    "dom-serializer": "3.1.1",
    "domhandler": "6.0.1",
    "fast-xml-parser": "5.11.2",
    "htmlparser2": "12.0.0",
    "vscode-languageclient": "10.1.2",
    "vscode-languageserver-protocol": "3.18.4",
    "vscode-languageserver-textdocument": "1.0.15",
    "vscode-messenger": "0.4.5",
    "vscode-messenger-common": "0.4.5",
    "vscode-ws-jsonrpc": "3.5.0"
  },
  "devDependencies": {
    "@axonivy/ui-icons": "next-14.0.1",
    "@types/vscode": "1.98.0",
    "@types/vscode-webview": "1.57.5",
    "@vscode/l10n-dev": "0.0.35",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "fonteditor-core": "2.6.3",
    "json-schema-to-typescript": "^16.0.0",
    "vitest": "5.0.3"
  },
  "activationEvents": [
    "workspaceContains:**/pom.xml",
    "onStartupFinished"
  ],
  "extensionPack": [
    "redhat.java",
    "vscjava.vscode-java-debug",
    "vscjava.vscode-java-test",
    "vscjava.vscode-maven",
    "vscjava.vscode-java-dependency"
  ],
  "contributes": {
    "configurationDefaults": {
      "workbench.iconTheme": "ivy-icon-theme-colored",
      "workbench.editorAssociations": {
        "{git,gitlens}:/**/{*.p.json,*.d.json,*.f.json,*.yaml}": "default"
      },
      "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://json-schema.axonivy.com/": true
      },
      "chat.tools.urls.autoApprove": {
        "https://json-schema.axonivy.com": {
          "approveRequest": true,
          "approveResponse": true
        }
      },
      "html.suggest.html5": false,
      "java.server.launchMode": "LightWeight",
      "java.configuration.updateBuildConfiguration": "automatic",
      "workbench.browser.newTabPlacement": "sideGroup",
      "java.diagnostic.filter": [
        "**/target/java-provider/java-provider.java",
        "**/src_generated/**",
        "**/target/generated-sources/**"
      ],
      "java.completion.matchCase": "off",
      "java.format.settings.url": "https://raw.githubusercontent.com/axonivy/vscode-designer/refs/heads/release/14.0/java-formatter/eclipse-formatter.xml",
      "java.format.settings.profile": "ivyteam",
      "[java]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "ivy.variableEditor",
        "displayName": "%editor.variables%",
        "selector": [
          {
            "filenamePattern": "variables.yaml"
          }
        ]
      },
      {
        "viewType": "ivy.roleEditor",
        "displayName": "%editor.roles%",
        "selector": [
          {
            "filenamePattern": "roles.yaml"
          }
        ]
      },
      {
        "viewType": "ivy.persistenceEditor",
        "displayName": "%editor.persistence%",
        "selector": [
          {
            "filenamePattern": "persistence.yaml"
          }
        ]
      },
      {
        "viewType": "ivy.userEditor",
        "displayName": "%editor.users%",
        "selector": [
          {
            "filenamePattern": "users.yaml"
          }
        ]
      },
      {
        "viewType": "ivy.restClientEditor",
        "displayName": "%editor.restClients%",
        "selector": [
          {
            "filenamePattern": "rest-clients.yaml"
          }
        ]
      },
      {
        "viewType": "ivy.webServiceClientEditor",
        "displayName": "%editor.webServiceClients%",
        "selector": [
          {
            "filenamePattern": "webservice-clients.yaml"
          }
        ]
      },
      {
        "viewType": "ivy.databaseEditor",
        "displayName": "%editor.databases%",
        "selector": [
          {
            "filenamePattern": "databases.yaml"
          }
        ]
      },
      {
        "viewType": "ivy.cmsEditor",
        "displayName": "%editor.cms%",
        "selector": [
          {
            "filenamePattern": "cms_*.yaml"
          }
        ]
      },
      {
        "viewType": "ivy.glspDiagram",
        "displayName": "%editor.processes%",
        "selector": [
          {
            "filenamePattern": "*.p.json"
          }
        ]
      },
      {
        "viewType": "ivy.casemapEditor",
        "displayName": "%editor.caseMaps%",
        "selector": [
          {
            "filenamePattern": "*.m.json"
          }
        ]
      },
      {
        "viewType": "ivy.formEditor",
        "displayName": "%editor.forms%",
        "selector": [
          {
            "filenamePattern": "*.f.json"
          }
        ]
      },
      {
        "viewType": "ivy.dataClassEditor",
        "displayName": "%editor.dataClasses%",
        "selector": [
          {
            "filenamePattern": "*.d.json"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "ivyEditor.openVariableEditor",
        "title": "%command.openVariableEditor%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyEditor.openCmsEditor",
        "title": "%command.openCmsEditor%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyEditor.openDatabaseEditor",
        "title": "%command.openDatabaseEditor%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyEditor.openRoleEditor",
        "title": "%command.openRoleEditor%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyEditor.openUserEditor",
        "title": "%command.openUserEditor%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyEditor.openRestClientEditor",
        "title": "%command.openRestClientEditor%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyEditor.openWebServiceClientEditor",
        "title": "%command.openWebServiceClientEditor%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyEditor.openCustomFieldEditor",
        "title": "%command.openCustomFieldEditor%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyEditor.openPersistenceEditor",
        "title": "%command.openPersistenceEditor%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyBrowserView.openDevWfUi",
        "title": "%command.openDeveloperWorkflowUi%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyBrowserView.openPortal",
        "title": "%command.openPortal%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyBrowserView.openEngineCockpit",
        "title": "%command.openEngineCockpit%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyBrowserView.openPreview",
        "title": "%command.openDialogPreview%",
        "category": "%category.axonIvy%",
        "icon": "$(play)",
        "enablement": "ivy:hasIvyProjects && ivy:dialogPreviewSupported"
      },
      {
        "command": "ivyPanelView.openRuntimeLog",
        "title": "%command.openRuntimeLog%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyPanelView.openExtensionLog",
        "title": "%command.openExtensionLog%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyPanelView.openEngineLog",
        "title": "%command.openEngineLog%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyPanelView.openWelcomePage",
        "title": "%command.openWelcomePage%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "workflow.fit",
        "title": "%command.fitToScreen%",
        "category": "%category.axonIvy%",
        "enablement": "activeCustomEditorId == 'ivy.glspDiagram'"
      },
      {
        "command": "workflow.center",
        "title": "%command.centerSelection%",
        "category": "%category.axonIvy%",
        "enablement": "activeCustomEditorId == 'ivy.glspDiagram'"
      },
      {
        "command": "workflow.layout",
        "title": "%command.layoutDiagram%",
        "category": "%category.axonIvy%",
        "enablement": "activeCustomEditorId == 'ivy.glspDiagram'"
      },
      {
        "command": "workflow.exportAsSVG",
        "title": "%command.exportAsSvg%",
        "category": "%category.axonIvy%",
        "enablement": "activeCustomEditorId == 'ivy.glspDiagram'"
      },
      {
        "command": "ivyProjects.refreshEntry",
        "title": "%command.refreshProjectExplorer%",
        "category": "%category.axonIvy%",
        "icon": "$(refresh)"
      },
      {
        "command": "ivyProjects.deployProject",
        "title": "%command.deployProject%",
        "category": "%category.axonIvy%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "engine.deployProjects",
        "title": "%command.deployAllProjects%",
        "category": "%category.axonIvy%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "engine.switchEngineReleaseTrain",
        "title": "%command.switchEngineReleaseTrain%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivy.debug.attachProcess",
        "title": "%command.attachProcessDebugger%",
        "category": "%category.axonIvy%",
        "icon": "$(debug-alt-small)",
        "enablement": "ivy:hasIvyProjects"
      },
      {
        "command": "ivyProjects.stopBpmEngine",
        "title": "%command.stopBpmEngine%",
        "category": "%category.axonIvy%",
        "icon": "$(stop-circle)"
      },
      {
        "command": "ivyProjects.convertProject",
        "title": "%command.convertProject%",
        "category": "%category.axonIvy%",
        "icon": "$(wrench)",
        "enablement": "ivy:hasProjectsToConvert && (view != ivyProjects || viewItem =~ /requiresConversion/)"
      },
      {
        "command": "ivyProjects.convertAllProjects",
        "title": "%command.convertAllProjects%",
        "category": "%category.axonIvy%",
        "icon": "$(wrench)",
        "enablement": "ivy:hasProjectsToConvert"
      },
      {
        "command": "ivyProjects.addBusinessProcess",
        "title": "%command.newBusinessProcess%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.addCallableSubProcess",
        "title": "%command.newCallableSubProcess%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.addWebServiceProcess",
        "title": "%command.newWebServiceProcess%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.importBpmnProcess",
        "title": "%command.importBpmnProcess%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.importIvyProject",
        "title": "%command.importProjectArchive%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.exportIvyProject",
        "title": "%command.exportProjectArchive%",
        "category": "%category.axonIvy%",
        "icon": "$(file-symlink-directory)"
      },
      {
        "command": "ivyProjects.installLocalMarketProduct",
        "title": "%command.installLocalMarketProduct%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.installMarketProduct",
        "title": "%command.installMarketProduct%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.addNewProject",
        "title": "%command.newProject%",
        "category": "%category.axonIvy%",
        "icon": "$(add)"
      },
      {
        "command": "ivyProjects.addNewHtmlDialog",
        "title": "%command.newHtmlDialog%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.addNewFormDialog",
        "title": "%command.newDialogForm%",
