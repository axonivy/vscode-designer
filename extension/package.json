          "when": "view == ivyProjects"
        },
        {
          "submenu": "view.title.new",
          "group": "navigation@2",
          "when": "view == ivyProjects"
        },
        {
          "command": "engine.deployProjects",
          "group": "navigation@3",
          "when": "view == ivyProjects && ivy:hasIvyProjects"
        },
        {
          "command": "ivyProjects.convertAllProjects",
          "group": "navigation@4",
          "when": "view == ivyProjects && ivy:hasProjectsToConvert"
        }
      ],
      "view.title.new": [
