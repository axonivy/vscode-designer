      },
      {
        "id": "ivy-icon-theme-colored",
        "label": "%iconTheme.colored%",
        "path": "./dist/icon-themes/ivy-icon-theme-colored.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "ivyProjects",
        "contents": "%welcome.emptyWorkspace%",
        "when": "workbenchState == empty"
      },
      {
        "view": "ivyProjects",
        "contents": "%welcome.noProjects%",
        "when": "workbenchState != empty && !ivy:hasIvyProjects && ivy:isStarted"
      }
    ]
  }
