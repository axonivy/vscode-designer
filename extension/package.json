      },
      {
        "command": "ivyProjects.addNewDataClass",
        "title": "%command.newDataClass%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.addNewEntityClass",
        "title": "%command.newEntityClass%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.addNewCaseMap",
        "title": "%command.newCaseMap%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.addDependency",
        "title": "%command.addProjectDependency%",
        "category": "%category.axonIvy%",
        "icon": "$(add)",
        "enablement": "ivy:hasIvyProjects"
      },
      {
        "command": "ivy.addDevContainer",
        "title": "%command.addDevContainer%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "engine.activateAnimation",
        "title": "%command.activateProcessAnimation%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "engine.deactivateAnimation",
        "title": "%command.deactivateProcessAnimation%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivyProjects.revealProjectInFileSystem",
        "title": "%command.revealProjectInFileSystem%",
        "category": "%category.axonIvy%",
        "icon": "$(file-directory)"
      },
      {
        "command": "ivyProjects.runWorkspaceValidation",
        "title": "%command.runWorkspaceValidation%",
        "category": "%category.axonIvy%"
      },
      {
        "command": "ivy.openSettings",
        "title": "%command.openSettings%",
        "category": "%category.axonIvy%"
      }
    ],
    "configuration": [
      {
        "title": "%setting.title%",
        "properties": {
          "axonivy.engine.runByExtension": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%setting.engine.runByExtension%",
            "order": 1000
          },
          "axonivy.engine.releaseTrain": {
            "type": "string",
            "default": "",
            "markdownDescription": "%setting.engine.releaseTrain%",
            "order": 1100
          },
          "axonivy.engine.url": {
            "type": "string",
            "default": "http://localhost:8080/",
            "markdownDescription": "%setting.engine.url%",
            "order": 1200
          },
          "axonivy.engine.vmArgs": {
            "type": "string",
            "default": "",
            "markdownDescription": "%setting.engine.vmArgs%",
            "order": 1300
          },
          "axonivy.localMcp.enabled": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%setting.localMcp.enabled%",
            "order": 1400
          },
          "axonivy.localMcp.host": {
            "type": "string",
            "default": "127.0.0.1",
            "markdownDescription": "%setting.localMcp.host%",
            "order": 1410
          },
          "axonivy.localMcp.port": {
            "type": "integer",
            "default": 32140,
            "minimum": 1,
            "maximum": 65535,
            "markdownDescription": "%setting.localMcp.port%",
            "order": 1420
          },
          "axonivy.localMcp.exposeAllTools": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%setting.localMcp.exposeAllTools%",
            "order": 1430
          },
          "axonivy.project.excludePattern": {
            "type": "string",
            "default": "**/{target,bin}/**",
            "markdownDescription": "%setting.project.excludePattern%",
            "order": 2000
          },
          "axonivy.project.maximumNumber": {
            "type": "integer",
            "default": 50,
            "markdownDescription": "%setting.project.maximumNumber%",
            "order": 2100
          },
          "axonivy.process.animation.animate": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%setting.process.animation.animate%"
          },
          "axonivy.process.animation.speed": {
            "type": "integer",
            "default": 50,
            "enum": [
              0,
              25,
              50,
              75,
              100
            ],
            "enumItemLabels": [
              "%setting.process.animation.fastest%",
              "%setting.process.animation.fast%",
              "%setting.process.animation.normal%",
              "%setting.process.animation.slow%",
              "%setting.process.animation.slowest%"
            ],
            "minimum": 0,
            "maximum": 100,
            "markdownDescription": "%setting.process.animation.speed%"
          },
          "axonivy.process.animation.mode": {
            "type": "string",
            "default": "all",
            "enum": [
              "all",
              "currentProcess",
              "openProcesses",
              "noDialogProcesses",
              "noEmbeddedProcesses"
            ],
            "enumItemLabels": [
              "%setting.process.animation.showAll%",
              "%setting.process.animation.currentEditor%",
              "%setting.process.animation.openEditors%",
              "%setting.process.animation.noDialogLogic%",
              "%setting.process.animation.topLevelProcesses%"
            ],
            "markdownDescription": "%setting.process.animation.mode%"
          },
          "axonivy.workspaceValidation": {
            "type": "object",
            "default": {
              "database": true,
              "dataclass": true,
              "form": true,
              "javaIndex": true,
              "process": true,
              "restclient": true,
              "role": true,
              "user": true,
              "variable": true,
              "webserviceclient": true,
              "xhtml": true
            },
            "properties": {
              "database": {
                "type": "boolean",
                "description": "%setting.validation.databases%"
              },
              "dataclass": {
                "type": "boolean",
                "description": "%setting.validation.dataClasses%"
              },
              "form": {
                "type": "boolean",
                "description": "%setting.validation.dialogs%"
              },
              "javaIndex": {
                "type": "boolean",
                "description": "%setting.validation.java%"
              },
              "process": {
                "type": "boolean",
                "description": "%setting.validation.processes%"
              },
              "restclient": {
                "type": "boolean",
                "description": "%setting.validation.restClients%"
              },
              "role": {
                "type": "boolean",
                "description": "%setting.validation.roles%"
              },
              "user": {
                "type": "boolean",
                "description": "%setting.validation.users%"
              },
              "variable": {
                "type": "boolean",
                "description": "%setting.validation.variables%"
              },
              "webserviceclient": {
                "type": "boolean",
                "description": "%setting.validation.webServices%"
              },
              "xhtml": {
                "type": "boolean",
                "description": "%setting.validation.xhtml%"
              }
            },
            "markdownDescription": "%setting.workspaceValidation%",
            "additionalProperties": false
          },
          "axonivy.browser": {
            "type": "string",
            "default": "vscodeBrowser",
            "enum": [
              "vscodeBrowser",
              "ivyBrowser",
              "externalBrowser"
            ],
            "markdownDescription": "%setting.browser%"
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "ivy-process",
        "label": "%debugger.label%",
        "languages": [
          "ivy-process"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "type",
              "request",
              "name"
            ],
            "properties": {
              "host": {
                "type": "string",
                "description": "%debugger.host%"
              },
              "port": {
                "type": "number",
                "description": "%debugger.port%",
                "minimum": 1,
                "maximum": 65535
              },
              "workspaceFolder": {
                "type": "string",
                "description": "%debugger.workspaceFolder%"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ivy-process",
            "request": "attach",
            "name": "%debugger.attachName%"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debugger.snippetLabel%",
            "description": "%debugger.snippetDescription%",
            "body": {
              "type": "ivy-process",
              "request": "attach",
              "name": "Attach to Axon Ivy Engine"
            }
          }
        ]
      }
    ],
    "chatSkills": [
      {
        "path": "./src/ai/skills/ivy-yaml-files/SKILL.md"
      },
      {
        "path": "./src/ai/skills/ivy-json-files/SKILL.md"
      }
    ],
    "languageModelTools": [
      {
        "name": "new_axon_ivy_project",
        "displayName": "%tool.newProject%",
        "modelDescription": "Scaffolds and registers a new Axon Ivy project. MUST be called for every request to create, add, scaffold, initialize, or generate an Axon Ivy project. Do NOT attempt to create the project by writing files, copying an existing project, or running shell/maven commands — only this tool produces a valid, registered project.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Only letters, numbers, underscores, and hyphens are allowed. No spaces."
            },
            "path": {
              "type": "string",
              "description": "Absolute filesystem path to the parent directory where the new project folder should be created. Do not use a dot-separated namespace directories."
            },
            "groupId": {
              "type": "string",
              "description": "Dot-separated namespace"
            },
            "projectId": {
              "type": "string",
              "description": "Only letters, numbers, underscores, and hyphens are allowed. No spaces."
            }
          },
          "required": [
            "name",
            "path",
            "groupId"
          ]
        },
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "newAxonIvyProject"
      },
      {
        "name": "new_axon_ivy_data_class",
        "displayName": "%tool.newDataClass%",
        "modelDescription": "Creates a new Axon Ivy Data Class or Entity Class. MUST be called for every request to create, add, scaffold, initialize, or generate an Axon Ivy Data Class. Do NOT attempt to create the Data Class by writing descriptor or Java files, or inspecting and copying existing Data Classes — only this tool produces a valid, registered Data Class.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Data Class name"
            },
            "namespace": {
              "type": "string",
              "description": "Dot-separated namespace"
            },
            "projectPath": {
              "type": "string",
              "description": "Absolute path to the project directory where the new Data Class should be created."
            },
            "type": {
              "type": "string",
              "enum": [
                "Data Class",
                "Entity Class"
              ],
              "default": "Data Class",
              "description": "Type of the class to create"
            }
          },
          "required": [
            "name",
            "namespace",
            "projectPath"
          ]
        },
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "newAxonIvyDataClass"
      },
      {
        "name": "new_axon_ivy_process",
        "displayName": "%tool.newProcess%",
        "modelDescription": "Creates a new Axon Ivy Process. MUST be called for every request to create, scaffold, initialize, or generate an Axon Ivy Process. Do NOT attempt to create the Process by writing files, or inspecting and copying existing Processes — only this tool produces a valid, registered Process.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Process name"
            },
            "namespace": {
              "type": "string",
              "default": "",
              "description": "Usually omit: default path is `{projectPath}/process/{name}.p.json`. Only set when explicitly requested, use a namespace that fits into {namespace} of `{projectPath}/process/{namespace}/{name}.p.json`."
            },
            "projectPath": {
              "type": "string",
              "description": "Absolute path to the project directory, in which the new Process should be created. MUST contain an '.ivyproject' file."
            },
            "type": {
              "type": "string",
              "enum": [
                "Business Process",
                "Callable Sub Process",
                "Web Service Process"
              ],
              "default": "Business Process",
              "description": "Type of the Process to create"
            }
          },
          "required": [
            "name",
            "projectPath"
          ]
        },
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "newAxonIvyProcess"
      },
      {
        "name": "new_axon_ivy_dialog",
        "displayName": "%tool.newDialog%",
        "modelDescription": "Creates a new Axon Ivy Dialog. MUST be called for every request to create, add, scaffold, initialize, or generate an Axon Ivy Dialog. Do NOT attempt to create the Dialog by writing files, or inspecting and copying existing Dialogs — only this tool produces a valid, registered Dialog.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Dialog name"
            },
            "namespace": {
              "type": "string",
              "description": "Dot-separated namespace"
            },
            "projectPath": {
              "type": "string",
              "description": "Absolute path to the project directory where the new Dialog should be created."
            },
            "type": {
              "type": "string",
              "enum": [
                "Form",
                "JSF",
                "JSFOffline"
              ],
              "default": "Form",
              "description": "Type of the Dialog to create"
            },
            "layout": {
              "type": "string",
              "enum": [
                "Page Responsive Grid 2 Columns",
                "Page Responsive Grid 4 Columns",
                "Page Responsive Top Labels",
                "Page Panel Grid",
                "Component"
              ],
              "default": "Page Responsive Grid 2 Columns",
              "description": "Layout to use for the new Dialog. Only applicable if type is 'JSF'."
            },
            "template": {
              "type": "string",
              "enum": [
                "basic-10",
                "frame-10",
                "frame-10-right",
                "frame-10-full-width"
              ],
              "default": "basic-10",
              "description": "Template to use for the new Dialog. Only applicable if type is 'JSF' and layout is not 'Component'."
            }
          },
          "required": [
            "name",
            "namespace",
            "projectPath"
          ]
        },
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "newAxonIvyDialog"
      }
    ],
    "viewsContainers": {
      "panel": [
