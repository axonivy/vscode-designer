          "command": "ivyProjects.addNewProject",
          "group": "1@1"
        },
        {
          "command": "ivyProjects.importIvyProject",
          "group": "1@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ivyProjects.convertProject",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "inline@1"
        },
        {
          "command": "ivyProjects.deployProject",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "inline@2"
        },
        {
          "submenu": "view.item",
          "group": "inline@3"
        },
        {
          "command": "ivyProjects.convertProject",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "1@1"
        },
        {
          "command": "ivyProjects.deployProject",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "1@2"
        },
        {
          "command": "ivyProjects.revealProjectInFileSystem",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "1@3"
        },
        {
          "command": "ivyProjects.exportIvyProject",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "1@4"
        },
        {
          "command": "ivy.debug.attachProcess",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "1@5"
        },
        {
          "command": "ivyProjects.stopBpmEngine",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "1@6"
        }
      ],
      "view.item": [
        {
          "command": "ivyProjects.revealProjectInFileSystem",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "1@1"
        },
        {
          "command": "ivyProjects.exportIvyProject",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "1@2"
        },
        {
          "command": "ivy.debug.attachProcess",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
          "group": "1@3"
        },
        {
          "command": "ivyProjects.stopBpmEngine",
          "when": "view == ivyProjects && viewItem =~ /ivyProject/",
