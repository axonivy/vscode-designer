{"$schema":"https://json-schema.org/draft/2019-09/schema","$defs":{"Installer":{"type":"object","additionalProperties":false,"properties":{"id":{"type":"string","anyOf":[{"const":"maven-import","description":"Imports IvyProjects into the workspace; it does not add them as dependencies to a project."},{"const":"maven-dependency","description":"Adds Maven dependencies to an existing project."}]},"data":{"type":"object"}},"allOf":[{"if":{"properties":{"id":{"const":"maven-import"}}},"then":{"properties":{"data":{"$ref":"#/$defs/MavenProjectInstaller"}}}},{"if":{"properties":{"id":{"const":"maven-dependency"}}},"then":{"properties":{"data":{"$ref":"#/$defs/MavenDependencyInstaller"}}}}]},"MavenDependencyInstaller":{"description":"Add the selected dependencies and required repositories to the consuming project's pom.xml.","type":"object","properties":{"dependencies":{"description":"Include all standalone dependencies and the selected entry from each requireOneOfGroup.","type":"array","items":{"$ref":"#/$defs/ProjectDependency"}},"repositories":{"description":"Repositories needed to resolve these dependencies.","type":"array","items":{"$ref":"#/$defs/Repository"}}},"additionalProperties":false},"MavenProjectInstaller":{"type":"object","properties":{"projects":{"description":"ivy projects as maven dependencies","type":"array","items":{"$ref":"#/$defs/Project"}},"repositories":{"description":"maven repositories where the projects are available","type":"array","items":{"$ref":"#/$defs/Repository"}}},"additionalProperties":false},"Project":{"type":"object","properties":{"artifactId":{"type":"string","description":"maven artifact id"},"groupId":{"type":"string","description":"maven group id"},"importInWorkspace":{"type":"boolean","description":"Whether the project should be imported into the workspace.","default":true},"type":{"type":"string","description":"maven type","default":"iar"},"version":{"type":"string","description":"maven version"}},"additionalProperties":false},"ProjectDependency":{"type":"object","properties":{"artifactId":{"type":"string","description":"Maven artifact ID."},"groupId":{"type":"string","description":"Maven group ID."},"optional":{"type":"boolean","description":"Set Maven's optional flag. This does not exclude the dependency from the project.","default":false},"requireOneOfGroup":{"type":"string","description":"Qualifier group key. Include at least one entry per key, choose the entry matching the requested qualifier, and omit unselected alternatives."},"type":{"type":"string","description":"Maven artifact type.","default":"jar"},"version":{"type":"string","description":"Maven version."}},"additionalProperties":false},"Repository":{"type":"object","properties":{"id":{"type":"string"},"layout":{"type":"string"},"name":{"type":"string"},"releases":{"$ref":"#/$defs/RepositoryPolicy"},"snapshots":{"$ref":"#/$defs/RepositoryPolicy"},"url":{"type":"string"}},"additionalProperties":false},"RepositoryPolicy":{"type":"object","properties":{"checksumPolicy":{"type":"string"},"enabled":{"type":"string"},"updatePolicy":{"type":"string"}},"additionalProperties":false}},"type":"object","properties":{"$schema":{"type":"string"},"installers":{"type":"array","items":{"$ref":"#/$defs/Installer"}},"minimumIvyVersion":{"type":"string","description":"The minimal version of ivy that is required to run this product.","pattern":"[0-9]\\.[0-9]\\.[0-9]"}},"additionalProperties":false}
