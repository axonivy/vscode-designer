pipeline {
  agent {
    dockerfile {
      filename 'build/Dockerfile.node'
    }
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '60', artifactNumToKeepStr: '2'))
  }

  triggers {
    cron '@midnight'
    upstream(upstreamProjects: "core_product/${java.net.URLEncoder.encode(env.BRANCH_NAME, 'UTF-8')},process-editor-client/${java.net.URLEncoder.encode(env.BRANCH_NAME, 'UTF-8')}", threshold: hudson.model.Result.UNSTABLE)
  }

  parameters {
    string(name: 'version', defaultValue: '', description: 'Version to release.')
    booleanParam(name: 'publishToMarket', description: 'Publish to VS Code Marketplace?')
    string(name: 'milestone', description: "Optional milestone number (e.g. 31 for Milestone 31). Only enter positive integers. Unset or empty publishes as a normal non-milestone release with the date timestamp.")
  }

  stages {
    stage('Validate preparations') {
      steps {
        script {
          if (params.publishToMarket) {
            assertReleaseBranch(env.BRANCH_NAME)
          }
          assertReleaseVersionFormat(params.version)
          assertReleaseVersionMatchesExtensionVersion(params.version)
          currentBuild.description = !params.publishToMarket ? "Dry run (${params.version})" : params.version
        }
      }
    }

    stage('Build') {
      steps {
        script {
          catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
            sh 'pnpm install && pnpm run update:axonivy:next'
            sh 'pnpm run build:production'
            sh 'pnpm run check'
          }
          withChecks('ESLint') {
            recordIssues enabledForFailure: true, publishAllIssues: true, aggregatingResults: true, tools: [esLint(pattern: 'eslint.xml', skipSymbolicLinks: true)], qualityGates: [[threshold: 1, type: 'TOTAL', unstable: true]]
          }
          withChecks('Test') {
            junit testDataPublishers: [[$class: 'StabilityTestDataPublisher']], testResults: 'extension/report.xml'
          }
        }
      }
    }

    stage('Publish to VS Code Marketplace') {
      when{
        expression { params.publishToMarket }
      }
      steps {
        script {
          def extVersion = getExtensionVersion()
          input "Would you like to publish version ${extVersion} from branch ${env.BRANCH_NAME}?"
        }
        withCredentials([string(credentialsId: 'marketplace.visualstudio.com', variable: 'VSCE_PAT')]) {
          sh "MILESTONE='${params.milestone}' pnpm run publish:next"
        }
        script {
          def majorVersion = params.version.tokenize('.')[0]
          currentBuild.description = "<a href='https://marketplace.visualstudio.com/items?itemName=axonivy.vscode-designer-${majorVersion}'>${params.version}</a>"
        }
      }
    }

    stage('Package') {
      steps {
        script {
          sh "MILESTONE='${params.milestone}' pnpm run package"
          archiveArtifacts 'extension/**/*.vsix'
        }
      }
    }
  }

  post {
    success {
      cleanWs()
    }
  }
} 

def assertReleaseBranch(def branch) {
  if (!isReleasingBranch(branchName: branch)) {
    error 'Releasing is only possible from a release branch.'
  }
}

def assertReleaseVersionFormat(def version) {
  if (!(version ==~ /\d+\.\d+\.\d+/)) {
    error "Expected a valid release version, got '${version}'."
  }
}

def assertReleaseVersionMatchesExtensionVersion(def version) {
  def expectedVersion = getExtensionVersion()
  if (version != expectedVersion) {
    error "Requested release ${version}, but extension/package.json resolves to ${expectedVersion}."
  }
}

def getExtensionVersion() {
  sh(script: "node -p \"require('./extension/package.json').version\"", returnStdout: true).trim()
}
