pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '2'))
    disableConcurrentBuilds()
  }

  triggers {
    cron '@midnight'
  }

  parameters {
    string(name: 'engineDownloadUrl', defaultValue: 'https://jenkins.ivyteam.io/job/core_product/job/master/lastSuccessfulBuild/artifact/workspace/ch.ivyteam.ivy.server.product/target/products/*_Slim_*.zip/*zip*/products.zip', description: 'engine that will be packaged')
  }

  stages {
    stage('Screenshots') {
      steps {
        script {
          docker.build('node-webtest', '-f build/Dockerfile.playwright .').inside {
            sh """
            pnpm install && pnpm run update:axonivy:next
            pnpm run build:production
            pnpm run engine:download ${params.engineDownloadUrl}
            nohup bash -c 'AxonIvyEngine/bin/AxonIvyEngine &'> ivy-engine-console.out
            """
            catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
              sh 'xvfb-run --auto-servernum --server-args="-screen 0 1920x1080x24" pnpm run test:playwright:screenshots'
            }
          }
          archiveArtifacts artifacts: 'playwright/test-results/**', allowEmptyArchive: true
          archiveArtifacts artifacts: 'AxonIvyEngine/logs/ivy.log', allowEmptyArchive: true
          archiveArtifacts artifacts: 'ivy-engine-console.out', allowEmptyArchive: true
          archiveArtifacts artifacts: 'playwright/tests/screenshots/target/screenshots/**', allowEmptyArchive: true
          withChecks('Screenshots') {
            junit testDataPublishers: [[$class: 'StabilityTestDataPublisher']], testResults: '**/node_modules/**/report.xml'
          }
        }
      }
    }
    stage('Deploy') {
      when {
        expression { isReleasingBranch() && currentBuild.currentResult == 'SUCCESS' }
      }
      steps {
        script {
          docker.build('maven-build', '-f build/Dockerfile.maven .').inside {
            maven cmd: '-ntp -f playwright/tests/screenshots deploy -Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn'
          }
          archiveArtifacts 'playwright/tests/screenshots/target/vscode-designer-screenshots-*.zip'
        }
      }
    }
  }
}
